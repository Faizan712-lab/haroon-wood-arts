NODE_ENV=production
PORT=5000
HOST=0.0.0.0
# Set only when the app is behind a known reverse proxy (for example, 1).
TRUST_PROXY_HOPS=0
# Comma-separated browser origins. Required in production; do not include a path.
CLIENT_ORIGIN=https://www.example.com
# "lax" is suitable for a same-site frontend/API. Use "none" only for truly
# cross-site deployments over HTTPS. COOKIE_DOMAIN is optional (for example, .example.com).
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# Use "local" for server/uploads during development. Production should use
# "cloudinary" only after all Cloudinary variables below are configured.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Rate-limit defaults use a 15-minute window. Values are per IP and should be
# tuned for the deployment's proxy/NAT topology.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_CUSTOMER_LOGIN_MAX=12
RATE_LIMIT_CUSTOMER_REGISTER_MAX=10
RATE_LIMIT_CUSTOMER_OTP_REQUEST_MAX=5
RATE_LIMIT_CUSTOMER_OTP_VERIFY_MAX=10
RATE_LIMIT_ADMIN_LOGIN_MAX=5
RATE_LIMIT_ADMIN_OTP_VERIFY_MAX=5
RATE_LIMIT_ADMIN_REGISTER_MAX=5
RATE_LIMIT_PASSWORD_REQUEST_MAX=5
RATE_LIMIT_PASSWORD_VERIFY_MAX=10
RATE_LIMIT_GOOGLE_AUTH_MAX=15
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=
ADMIN_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_MAX_COUNT=
ADMIN_DEVICE_COOKIE_DAYS=
EMAIL_USER=
EMAIL_PASS=
ADMIN_NOTIFICATION_EMAIL=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=
# Development only: Vite's local proxy target.
VITE_API_PROXY_TARGET=
