{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/shop",
      "destination": "/shop/index.html"
    },
    {
      "source": "/shop/",
      "destination": "/shop/index.html"
    },
    {
      "source": "/categories",
      "destination": "/categories/index.html"
    },
    {
      "source": "/categories/",
      "destination": "/categories/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/about/",
      "destination": "/about/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-and-conditions/index.html"
    },
    {
      "source": "/terms-and-conditions/",
      "destination": "/terms-and-conditions/index.html"
    },
    {
      "source": "/product/(.*)",
      "destination": "/spa-shell.html"
    },
    {
      "source": "/(.*)",
      "destination": "/spa-shell.html"
    }
  ]
}
